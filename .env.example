# GREEN HOLDING LIVE COMMAND CENTER v3
ENVIRONMENT=development
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
ACCESS_TOKEN_MINUTES=720
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
APP_PORT=8080
DATABASE_URL=sqlite:///./green_holding.db
DATA_PROVIDER=MOCK
LIVE_STATUS_PROVIDER=MOCK
POLLING_INTERVAL_SECONDS=180
METRIC_SNAPSHOT_INTERVAL_SECONDS=180
REFUND_SNAPSHOT_OFFSETS=0,1,3,6,12,24,48
FINAL_SNAPSHOT_AFTER_HOURS=168
SEED_MOCK_DATA=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
TIKTOK_SHOP_BASE_URL=https://open-api.tiktokglobalshop.com
TIKTOK_SHOP_AUTH_URL=https://auth.tiktok-shops.com/api/v2
TIKTOK_ADS_BASE_URL=https://business-api.tiktok.com/open_api/v1.3

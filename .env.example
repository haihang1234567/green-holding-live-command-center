# ============================================================
# GREEN HOLDING LIVE COMMAND CENTER
# Copy to .env before running: cp .env.example .env
# ============================================================

# Core
ENVIRONMENT=development
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
ACCESS_TOKEN_MINUTES=720
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
APP_PORT=8080

# PostgreSQL
POSTGRES_DB=green_holding
POSTGRES_USER=green
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD

# Start with MOCK. When TikTok credentials are approved, change to TIKTOK.
DATA_PROVIDER=MOCK
# MOCK: simulated detection | MANUAL: admin Start/Stop | TIKTOK_ENDPOINT: optional supplied LIVE endpoint
LIVE_STATUS_PROVIDER=MOCK
POLLING_INTERVAL_SECONDS=30
METRIC_SNAPSHOT_INTERVAL_SECONDS=60
REFUND_SNAPSHOT_OFFSETS=0,1,3,6,12,24,48
FINAL_SNAPSHOT_AFTER_HOURS=168
SEED_MOCK_DATA=true

# Initial admin. Change these before production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---------------- TikTok Shop Open API ----------------
TIKTOK_SHOP_BASE_URL=https://open-api.tiktokglobalshop.com
TIKTOK_SHOP_AUTH_URL=https://auth.tiktok-shops.com/api/v2
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
# Single-shop/global fallback token. For two shops, prefer JSON maps below.
TIKTOK_SHOP_ACCESS_TOKEN=
TIKTOK_SHOP_REFRESH_TOKEN=
# Example: {"SHOP_CIPHER_1":"token_1","SHOP_CIPHER_2":"token_2"}
TIKTOK_SHOP_ACCESS_TOKENS_JSON={}
TIKTOK_SHOP_REFRESH_TOKENS_JSON={}

# ---------------- TikTok Marketing API ----------------
TIKTOK_ADS_BASE_URL=https://business-api.tiktok.com/open_api/v1.3
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_SECRET=
TIKTOK_ADS_ACCESS_TOKEN=
# Keep only metrics approved/available in your account.
TIKTOK_ADS_METRICS=spend,impressions,clicks,conversion
# Fill exact approved metric names if revenue/ROAS are available in your account.
TIKTOK_ADS_REVENUE_METRIC=
TIKTOK_ADS_ROAS_METRIC=

# ---------------- Optional LIVE status adapter ----------------
# Only use when TikTok/partner gives you an actual endpoint or middleware endpoint.
TIKTOK_LIVE_STATUS_URL=
TIKTOK_LIVE_STATUS_METHOD=GET
TIKTOK_LIVE_STATUS_TOKEN=
TIKTOK_LIVE_STATUS_CHANNEL_PARAM=channel_id
TIKTOK_LIVE_STATUS_JSON_PATH=data.status
TIKTOK_LIVE_VALUE=LIVE
TIKTOK_OFFLINE_VALUE=OFFLINE

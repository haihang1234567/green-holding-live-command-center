# Core
ENVIRONMENT=production
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://livecenter:change-me@db:5432/livecenter
CORS_ORIGINS=http://localhost:3000
DATA_PROVIDER=MOCK
POLL_INTERVAL_SECONDS=60
MOCK_TICK_SECONDS=12

# Initial accounts - change in production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
TEAM_DEFAULT_PASSWORD=team123

# TikTok Shop - backend only
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_ACCESS_TOKEN=
TIKTOK_SHOP_ORDERS_URL=
TIKTOK_SHOP_PRODUCTS_URL=
TIKTOK_SHOP_REFUNDS_URL=

# TikTok Ads - backend only
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_SECRET=
TIKTOK_ADS_ACCESS_TOKEN=
TIKTOK_ADS_METRICS_URL=

# Optional LIVE status endpoint. Leave blank if TikTok does not provide one.
TIKTOK_LIVE_STATUS_URL=

# Response field mapping for the approved API package
MAP_ORDER_ID=order_id
MAP_ORDER_AMOUNT=amount
MAP_ORDER_STATUS=status
MAP_PRODUCT_ID=product_id
MAP_SKU_ID=sku_id
MAP_LIVE_STATUS=status

# ============================================================
# GREEN HOLDING LIVE COMMAND CENTER V2
# ============================================================

ENVIRONMENT=development
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
ACCESS_TOKEN_MINUTES=720
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
APP_PORT=8080

POSTGRES_DB=green_holding
POSTGRES_USER=green
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD

# MOCK while waiting for API. Switch both lines below when production credentials arrive.
DATA_PROVIDER=MOCK
LIVE_STATUS_PROVIDER=MOCK
# Production target:
# DATA_PROVIDER=TIKTOK
# LIVE_STATUS_PROVIDER=AUTO

# Server calls LIVE status and session metrics every 3 minutes.
POLLING_INTERVAL_SECONDS=180
METRIC_SNAPSHOT_INTERVAL_SECONDS=180
REFUND_SNAPSHOT_OFFSETS=0,1,3,6,12,24,48
FINAL_SNAPSHOT_AFTER_HOURS=168
SEED_MOCK_DATA=true

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Shared metric configuration only. Credentials below are NOT shared.
TIKTOK_ADS_METRICS=spend,impressions,clicks,conversion
TIKTOK_ADS_REVENUE_METRIC=
TIKTOK_ADS_ROAS_METRIC=

# ============================================================
# SHOP 1 / CHANNEL 1 - completely independent credential set
# ============================================================
SHOP1_CHANNEL_ID=1
SHOP1_NAME=SHOP 1
SHOP1_SHOP_BASE_URL=https://open-api.tiktokglobalshop.com
SHOP1_AUTH_URL=https://auth.tiktok-shops.com/api/v2
SHOP1_APP_KEY=
SHOP1_APP_SECRET=
SHOP1_ACCESS_TOKEN=
SHOP1_REFRESH_TOKEN=
SHOP1_SHOP_CIPHER=
SHOP1_SHOP_ID=

SHOP1_ADS_BASE_URL=https://business-api.tiktok.com/open_api/v1.3
SHOP1_ADS_APP_ID=
SHOP1_ADS_SECRET=
SHOP1_ADS_ACCESS_TOKEN=
SHOP1_ADVERTISER_ID=

# Automatic LIVE detector for Shop 1.
# AUTH_MODE: BEARER | TIKTOK_SHOP | NONE
SHOP1_LIVE_STATUS_URL=
SHOP1_LIVE_STATUS_METHOD=GET
SHOP1_LIVE_STATUS_AUTH_MODE=BEARER
SHOP1_LIVE_STATUS_TOKEN=
SHOP1_LIVE_STATUS_CHANNEL_PARAM=channel_id
SHOP1_LIVE_STATUS_JSON_PATH=data.status
SHOP1_LIVE_VALUE=LIVE
SHOP1_OFFLINE_VALUE=OFFLINE
SHOP1_LIVE_SOURCE_KEY=

# ============================================================
# SHOP 2 / CHANNEL 2 - completely independent credential set
# ============================================================
SHOP2_CHANNEL_ID=2
SHOP2_NAME=SHOP 2
SHOP2_SHOP_BASE_URL=https://open-api.tiktokglobalshop.com
SHOP2_AUTH_URL=https://auth.tiktok-shops.com/api/v2
SHOP2_APP_KEY=
SHOP2_APP_SECRET=
SHOP2_ACCESS_TOKEN=
SHOP2_REFRESH_TOKEN=
SHOP2_SHOP_CIPHER=
SHOP2_SHOP_ID=

SHOP2_ADS_BASE_URL=https://business-api.tiktok.com/open_api/v1.3
SHOP2_ADS_APP_ID=
SHOP2_ADS_SECRET=
SHOP2_ADS_ACCESS_TOKEN=
SHOP2_ADVERTISER_ID=

SHOP2_LIVE_STATUS_URL=
SHOP2_LIVE_STATUS_METHOD=GET
SHOP2_LIVE_STATUS_AUTH_MODE=BEARER
SHOP2_LIVE_STATUS_TOKEN=
SHOP2_LIVE_STATUS_CHANNEL_PARAM=channel_id
SHOP2_LIVE_STATUS_JSON_PATH=data.status
SHOP2_LIVE_VALUE=LIVE
SHOP2_OFFLINE_VALUE=OFFLINE
SHOP2_LIVE_SOURCE_KEY=

# Legacy single-profile values can stay empty. They are only fallbacks.
TIKTOK_SHOP_BASE_URL=https://open-api.tiktokglobalshop.com
TIKTOK_SHOP_AUTH_URL=https://auth.tiktok-shops.com/api/v2
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_ACCESS_TOKEN=
TIKTOK_SHOP_REFRESH_TOKEN=
TIKTOK_SHOP_ACCESS_TOKENS_JSON={}
TIKTOK_SHOP_REFRESH_TOKENS_JSON={}
TIKTOK_ADS_BASE_URL=https://business-api.tiktok.com/open_api/v1.3
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_SECRET=
TIKTOK_ADS_ACCESS_TOKEN=
